#include "reference.hpp"
#include <nanobind/nanobind.h>
#include <nanobind/stl/map.h>
#include <nanobind/stl/string.h>
#include <nanobind/stl/vector.h>

namespace nb = nanobind;

NB_MODULE(@LSCE_MODULE@, module) {
    module.def("reference_frames", &reference_frames,
               nb::arg("n_frames").noconvert() = 10,
               "Generate deterministic inputs and the complete fixed-point reference.");
}
